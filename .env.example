# Application
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
SELF_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
# Use the provisioned PostgreSQL connection string. Do not use SQLite.
DATABASE_URL=postgresql://user:password@host:5432/database

# Object storage: S3-compatible Tigris bucket.
# The app uses the S3_* naming scheme; do not invent alternate storage names.
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=replace-with-bucket
S3_PREFIX=app_xianda_wan_90d4_auto_paper_wri_adf0d3/
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# myClawTeam auth service
MCTAI_AUTH_URL=https://auth.mctai.app
MCTAI_AUTH_APP_TOKEN=replace-with-app-token
MCTAI_AUTH_JWKS_URL=https://auth.mctai.app/.well-known/jwks.json

# Claude / Anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=replace-with-claude-model
