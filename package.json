{
  "name": "xianda-wan-90d4-auto-paper-wri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev -- --host 0.0.0.0",
    "build:web": "npm --workspace apps/web run build",
    "preview:web": "npm --workspace apps/web run preview -- --host 0.0.0.0",
    "dev:api": "uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8080 --reload",
    "start:api": "uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8080",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "lint:web": "npm --workspace apps/web run lint",
    "format:web": "npm --workspace apps/web run format",
    "format:check:web": "npm --workspace apps/web run format:check",
    "lint:api": "python3 -m ruff check apps/api",
    "test:api": "PYTHONPATH=apps/api python3 -m pytest apps/api/tests",
    "format:api": "python3 -m black apps/api",
    "format:check:api": "python3 -m black --check apps/api",
    "lint": "npm run lint:web && npm run lint:api",
    "format": "npm run format:web && npm run format:api",
    "format:check": "npm run format:check:web && npm run format:check:api",
    "typecheck": "npm run typecheck:web",
    "db:migrate": "python3 -m alembic upgrade head",
    "db:revision": "python3 -m alembic revision --autogenerate",
    "build": "npm run typecheck && npm run build:web && python3 -m compileall apps/api/app"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9",
    "python": ">=3.11"
  }
}
